# WICHTIG: Kommentare stehen nur in eigenen Zeilen, nie hinter einem Wert (Docker Compose würde sie als Wert übernehmen).
# Kopiere diese Datei nach ".env" im Projektwurzelverzeichnis (neben docker-compose.yml):
#   cp .env.example .env
# Die Datei ".env" wird nie committet (.gitignore). Schlüssel niemals in den Code oder in den Chat schreiben.

# --- Allgemein ---
# development | production
APP_ENV=development
# true = ausdrücklich gekennzeichnete Beispieldaten (nie mit echten Daten mischen)
DEMO_MODE=false
TIMEZONE=Europe/Berlin
DATABASE_URL=sqlite:////data/marktmuster.db
# Port, unter dem das Dashboard lokal erreichbar ist
WEB_PORT=8080

# --- Login / Sessions ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168
# true, sobald HTTPS genutzt wird (Serverbetrieb)
COOKIE_SECURE=false
# Nur für den Serverbetrieb mit öffentlicher HTTPS-Adresse (Weg B, siehe docs/betrieb.md): Domain, deren A-Eintrag auf den Server zeigt. Leer lassen für lokal und Tailscale.
DOMAIN=
# Erster Administrator (wird beim Start angelegt, falls noch kein Admin existiert). Registrierung ist nur per Einladung durch einen Admin möglich.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# --- Kursdaten (Phase 1B) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FINNHUB_API_KEY=
STOOQ_API_KEY=
# optional
OPENFIGI_API_KEY=
# EODHD_API_KEY=                    # späteres Upgrade für XETRA-Intraday (nicht im 0-Euro-Plan)
# optional, inoffiziell: Tagesdaten US/XETRA, z. B. wenn es keinen Stooq-Schlüssel gibt
YAHOO_ENABLED=false

# Zwischenspeicher der Tagesdaten für den Muster-Backtest (Phase 3C)
BACKTEST_CACHE_DIR=/data/backtest-cache

# --- Nachrichten (Phase 2) ---
# Pflicht im User-Agent für SEC EDGAR
SEC_EDGAR_CONTACT_EMAIL=
MARKETAUX_API_KEY=
# optional
ALPHAVANTAGE_API_KEY=
# Feeds sind aus, bis du sie freischaltest. Vorher Adresse und Nutzungsbedingungen des Feeds prüfen (siehe Seite Quellen).
# z. B. tagesschau,cnbc,marketwatch,handelsblatt oder all
RSS_ENABLED_FEEDS=
# Investor-Relations-Feeds: AAPL|https://.../feed.xml,SAP.DE|https://.../rss (nur https), Nutzungsbedingungen prüfen
IR_FEEDS=
# Feed-Adresse der EQS-News (Ad-hoc-Meldungen), Nutzungsbedingungen prüfen
EQS_RSS_URL=

# --- KI (Phase 2C / 4C, optional) ---
ANTHROPIC_API_KEY=
# harte Obergrenze, danach Lexikon-Fallback
CLAUDE_MONTHLY_BUDGET_USD=10
# Stimmung per Batch-API (halber Preis, Ergebnis nach Minuten bis Stunden)
CLAUDE_USE_BATCH=true
# ältere Meldungen löschen (mindestens 14; 0 = nie löschen)
NEWS_RETENTION_DAYS=90
