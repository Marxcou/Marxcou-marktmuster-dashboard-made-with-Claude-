# Kopiere diese Datei nach ".env" im Projektwurzelverzeichnis (neben docker-compose.yml):
#   cp .env.example .env
# Die Datei ".env" wird nie committet (.gitignore). Schlüssel niemals in den Code oder in den Chat schreiben.

# --- Allgemein ---
APP_ENV=development                 # development | production
DEMO_MODE=false                     # true = ausdrücklich gekennzeichnete Beispieldaten (nie mit echten Daten mischen)
TIMEZONE=Europe/Berlin
DATABASE_URL=sqlite:////data/marktmuster.db
WEB_PORT=8080                       # Port, unter dem das Dashboard lokal erreichbar ist

# --- Login / Sessions ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168
COOKIE_SECURE=false                 # true, sobald HTTPS genutzt wird (Serverbetrieb)
# Erster Administrator (wird beim Start angelegt, falls noch kein Admin existiert). Registrierung ist nur per Einladung durch einen Admin möglich.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# --- Kursdaten (Phase 1B) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FINNHUB_API_KEY=
STOOQ_API_KEY=
OPENFIGI_API_KEY=                   # optional
# EODHD_API_KEY=                    # späteres Upgrade für XETRA-Intraday (nicht im 0-Euro-Plan)
YAHOO_ENABLED=false                 # optional, inoffiziell, standardmäßig aus

# --- Nachrichten (Phase 2) ---
SEC_EDGAR_CONTACT_EMAIL=            # Pflicht im User-Agent für SEC EDGAR
MARKETAUX_API_KEY=
ALPHAVANTAGE_API_KEY=               # optional
# Feeds sind aus, bis du sie freischaltest. Vorher Adresse und Nutzungsbedingungen des Feeds prüfen (siehe Seite Quellen).
RSS_ENABLED_FEEDS=                  # z. B. tagesschau,cnbc,marketwatch,handelsblatt oder all
IR_FEEDS=                          # Investor-Relations-Feeds: AAPL|https://.../feed.xml,SAP.DE|https://.../rss (nur https), Nutzungsbedingungen prüfen
EQS_RSS_URL=                        # Feed-Adresse der EQS-News (Ad-hoc-Meldungen), Nutzungsbedingungen prüfen

# --- KI (Phase 2C / 4C, optional) ---
ANTHROPIC_API_KEY=
CLAUDE_MONTHLY_BUDGET_USD=10        # harte Obergrenze, danach Lexikon-Fallback
CLAUDE_USE_BATCH=true               # Stimmung per Batch-API (halber Preis, Ergebnis nach Minuten bis Stunden)
NEWS_RETENTION_DAYS=90              # ältere Meldungen löschen (mindestens 14; 0 = nie löschen)
